{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Virtual Science Park ecosystem contracts",
  "$defs": {
    "Company": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "sector": {
          "type": "string",
          "enum": [
            "Marine technology",
            "Digital solutions",
            "Industry & engineering"
          ]
        },
        "isDemo": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "industry",
        "sector",
        "isDemo"
      ],
      "additionalProperties": false
    },
    "CompanyProfile": {
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "productsServices": {
          "type": "string",
          "minLength": 1
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "markets": {
          "type": "string",
          "minLength": 1
        },
        "customerGroups": {
          "type": "string",
          "minLength": 1
        },
        "geographicalFocus": {
          "type": "string",
          "minLength": 1
        },
        "developmentPriorities": {
          "type": "string",
          "minLength": 1
        },
        "projectsCollaborations": {
          "type": "string",
          "minLength": 1
        },
        "opportunityInterests": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Funding",
              "Events",
              "Workshops",
              "Networking",
              "Testing",
              "Collaborations"
            ]
          }
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "name",
                  "description",
                  "productsServices",
                  "technologies",
                  "markets",
                  "customerGroups",
                  "geographicalFocus",
                  "developmentPriorities",
                  "projectsCollaborations",
                  "opportunityInterests"
                ]
              },
              {
                "not": {}
              }
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "classification": {
                "type": "string",
                "enum": [
                  "fact",
                  "inference",
                  "companyProvided",
                  "missing"
                ]
              },
              "sourceLabel": {
                "type": "string",
                "minLength": 1
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "retrievedOn": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "uncertainty": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "classification"
            ],
            "additionalProperties": false
          }
        },
        "visibility": {
          "type": "string",
          "const": "published"
        }
      },
      "required": [
        "companyId",
        "name",
        "technologies",
        "opportunityInterests",
        "evidence",
        "visibility"
      ],
      "additionalProperties": false
    },
    "PrivateCompanyProfile": {
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "productsServices": {
          "type": "string",
          "minLength": 1
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "markets": {
          "type": "string",
          "minLength": 1
        },
        "customerGroups": {
          "type": "string",
          "minLength": 1
        },
        "geographicalFocus": {
          "type": "string",
          "minLength": 1
        },
        "developmentPriorities": {
          "type": "string",
          "minLength": 1
        },
        "projectsCollaborations": {
          "type": "string",
          "minLength": 1
        },
        "opportunityInterests": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Funding",
              "Events",
              "Workshops",
              "Networking",
              "Testing",
              "Collaborations"
            ]
          }
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "name",
                  "description",
                  "productsServices",
                  "technologies",
                  "markets",
                  "customerGroups",
                  "geographicalFocus",
                  "developmentPriorities",
                  "projectsCollaborations",
                  "opportunityInterests"
                ]
              },
              {
                "not": {}
              }
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "classification": {
                "type": "string",
                "enum": [
                  "fact",
                  "inference",
                  "companyProvided",
                  "missing"
                ]
              },
              "sourceLabel": {
                "type": "string",
                "minLength": 1
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "retrievedOn": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "uncertainty": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "classification"
            ],
            "additionalProperties": false
          }
        },
        "visibility": {
          "type": "string",
          "const": "private"
        },
        "privateNotes": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
        }
      },
      "required": [
        "companyId",
        "name",
        "technologies",
        "opportunityInterests",
        "evidence",
        "visibility"
      ],
      "additionalProperties": false
    },
    "ProfileEvidence": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "fact",
            "inference",
            "companyProvided",
            "missing"
          ]
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "retrievedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification"
      ],
      "additionalProperties": false
    },
    "Opportunity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "Funding",
            "Events",
            "Workshops",
            "Networking",
            "Testing",
            "Collaborations"
          ]
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "publishedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "retrievedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "eventOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "deadlineOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "schedulingLabel": {
          "type": "string",
          "minLength": 1
        },
        "eligibility": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "isDemo": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "category",
        "technologies",
        "industries",
        "sourceLabel",
        "sourceUrl",
        "eligibility",
        "isDemo"
      ],
      "additionalProperties": false
    },
    "Recommendation": {
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "opportunity"
                },
                "opportunityId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                }
              },
              "required": [
                "kind",
                "opportunityId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "collaboration"
                },
                "targetCompanyId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                }
              },
              "required": [
                "kind",
                "targetCompanyId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "sharedTechnology",
                  "preferredCategory",
                  "industryFit"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "kind",
              "values"
            ],
            "additionalProperties": false
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "const": "suggested"
        },
        "isDemo": {
          "type": "boolean"
        }
      },
      "required": [
        "companyId",
        "target",
        "explanation",
        "factors",
        "status",
        "isDemo"
      ],
      "additionalProperties": false
    },
    "User": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "const": "representative"
            },
            "companyId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          },
          "required": [
            "id",
            "name",
            "role",
            "companyId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "const": "staff"
            },
            "companyId": {
              "type": "null"
            }
          },
          "required": [
            "id",
            "name",
            "role",
            "companyId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "const": "unassigned"
            },
            "companyId": {
              "type": "null"
            }
          },
          "required": [
            "id",
            "name",
            "role",
            "companyId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProfileReviewRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "companyId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "requesterId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "recipientId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
        }
      },
      "required": [
        "id",
        "companyId",
        "requesterId",
        "recipientId",
        "status",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "ChatMessage": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "role",
        "text"
      ],
      "additionalProperties": false
    },
    "ChatRequest": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "companyId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question",
        "companyId",
        "history"
      ],
      "additionalProperties": false
    },
    "ChatResponse": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "focus"
                },
                "companyId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                }
              },
              "required": [
                "kind",
                "companyId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "filter"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Funding",
                    "Events",
                    "Workshops",
                    "Networking",
                    "Testing",
                    "Collaborations"
                  ]
                }
              },
              "required": [
                "kind",
                "category"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "highlight"
                },
                "opportunityIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                  }
                },
                "companyIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                  }
                }
              },
              "required": [
                "kind",
                "opportunityIds",
                "companyIds"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          }
        },
        "simulated": {
          "type": "boolean"
        }
      },
      "required": [
        "answer",
        "action",
        "sources",
        "simulated"
      ],
      "additionalProperties": false
    }
  }
}

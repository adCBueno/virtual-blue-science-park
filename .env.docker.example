# Copy to .env.docker (never committed). Passed to the container at runtime.

# Port inside the container (map it with -p HOST:3000)
PORT=3000

# Team backend (FastAPI). Inside the backend's Compose network: http://api:8000
# From a container to a backend running on your machine: http://host.docker.internal:8000
# Leave empty to run the UI on its built-in demo data.
API_URL=http://api:8000
